{
  "manifest_version": 3,
  "name": "Cruzader Block",
  "version": "1.0.0",
  "description": "Bloqueador de dominios y palabras clave con censura ASCII y retraso de 24h.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cruzader-block@cleanreset.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "assets/logo.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lists/domains.js",
      "lists/keywords.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lists/keywords.js",
        "content/censor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cruzader Block"
  }
}
